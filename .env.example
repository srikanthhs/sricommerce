# Postgres connection string. Leave unset locally to use the built-in PGlite database in ./data.
DATABASE_URL=
# Comma-separated mobile numbers / Google emails that can open /admin.
ADMIN_PHONES=
ADMIN_EMAILS=
# "true" shows the login OTP on screen (until an SMS provider is connected). Admin numbers never get an on-screen code.
SHOW_OTP_ON_SCREEN=true

# Firebase Phone Auth (real SMS OTP). With NEXT_PUBLIC_FIREBASE_LOGIN=
# Google sign-in is on whenever the Firebase config is set; "false" hides the button.
NEXT_PUBLIC_GOOGLE_LOGIN=true, the built-in OTP above is switched off.
NEXT_PUBLIC_FIREBASE_LOGIN=
# Google sign-in is on whenever the Firebase config is set; "false" hides the button.
NEXT_PUBLIC_GOOGLE_LOGIN=
# Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
